--- before/projects/04-pulsestream/scripts/benchmark-engine.sh
+++ after/projects/04-pulsestream/scripts/benchmark-engine.sh
@@ -4,9 +4,9 @@
 require_current_build
 [[ -f "$PULSE_RUNTIME/classpath.fingerprint" && "$(cat "$PULSE_RUNTIME/classpath.fingerprint")" == "$(fingerprint)" && -f "$PULSE_PROJECT/verification/target/runtime-classpath.txt" ]] || { echo 'Run scripts/prepare-benchmark.sh before reserving the quiet host' >&2; exit 1; }
 PULSE_RUN_ID="engine-$(date +%s)${BASHPID}"
-mkdir -p "$PULSE_RUNTIME/$PULSE_RUN_ID"
+mkdir -p "$PULSE_RUNTIME/$PULSE_RUN_ID/jfr"
 PULSE_CLASSPATH=$(cat "$PULSE_PROJECT/verification/target/runtime-classpath.txt")
 python3 "$PULSE_PROJECT/scripts/capture-environment.py" "$PULSE_RUNTIME/$PULSE_RUN_ID/environment.json"
-bounded 600 java -Xmx512m -cp "$PULSE_PROJECT/verification/target/classes:$PULSE_CLASSPATH" org.openjdk.jmh.Main '.*EngineBenchmark.*' -f 3 -wi 2 -i 3 -w 1s -r 1s -prof gc -prof "jfr:dir=$PULSE_RUNTIME/$PULSE_RUN_ID/jfr" -rf json -rff "$PULSE_RUNTIME/$PULSE_RUN_ID/jmh.json" 2>&1 | tee "$PULSE_RUNTIME/$PULSE_RUN_ID/console.log"
+bounded 600 java -Xmx512m -cp "$PULSE_PROJECT/verification/target/classes:$PULSE_CLASSPATH" org.openjdk.jmh.Main '.*EngineBenchmark.*' -f 3 -wi 2 -i 3 -w 1s -r 1s -prof gc -jvmArgsAppend "-XX:StartFlightRecording=filename=$PULSE_RUNTIME/$PULSE_RUN_ID/jfr/profile-%p.jfr,settings=profile,dumponexit=true" -rf json -rff "$PULSE_RUNTIME/$PULSE_RUN_ID/jmh.json" 2>&1 | tee "$PULSE_RUNTIME/$PULSE_RUN_ID/console.log"
 printf '%s\n' "$PULSE_RUN_ID" > "$PULSE_RUNTIME/last-engine-run"
 echo "Observed engine JMH artifacts: $PULSE_RUNTIME/$PULSE_RUN_ID"
--- before/.work/A04/run-engine-baseline.sh
+++ after/.work/A04/run-engine-baseline.sh
@@ -15,13 +15,13 @@
 PY
 PULSE_RUN_ID="engine-baseline-$(date +%s)${BASHPID}"
 PULSE_OUTPUT="$PULSE_RUNTIME/$PULSE_RUN_ID"
-mkdir -p "$PULSE_OUTPUT"
+mkdir -p "$PULSE_OUTPUT/jfr"
 PULSE_CLASSPATH=$(cat "$PULSE_PROJECT/verification/target/runtime-classpath.txt")
 python3 "$PULSE_PROJECT/scripts/capture-environment.py" "$PULSE_OUTPUT/environment.json"
 cp "$PULSE_BASELINE/manifest.json" "$PULSE_OUTPUT/baseline-engine-manifest.json"
 # Standard Java/JMH classpath ordering loads these preserved original Engine classes first.
 # Harness, dependencies, fork count, warmup, duration and profilers match benchmark-engine.sh.
 printf '%s\n' "$PULSE_BASELINE/classes:$PULSE_PROJECT/verification/target/classes:$PULSE_CLASSPATH" > "$PULSE_OUTPUT/classpath.txt"
-bounded 600 java -Xmx512m -cp "$PULSE_BASELINE/classes:$PULSE_PROJECT/verification/target/classes:$PULSE_CLASSPATH" org.openjdk.jmh.Main '.*EngineBenchmark.*' -f 3 -wi 2 -i 3 -w 1s -r 1s -prof gc -prof "jfr:dir=$PULSE_OUTPUT/jfr" -rf json -rff "$PULSE_OUTPUT/jmh.json" 2>&1 | tee "$PULSE_OUTPUT/console.log"
+bounded 600 java -Xmx512m -cp "$PULSE_BASELINE/classes:$PULSE_PROJECT/verification/target/classes:$PULSE_CLASSPATH" org.openjdk.jmh.Main '.*EngineBenchmark.*' -f 3 -wi 2 -i 3 -w 1s -r 1s -prof gc -jvmArgsAppend "-XX:StartFlightRecording=filename=$PULSE_OUTPUT/jfr/profile-%p.jfr,settings=profile,dumponexit=true" -rf json -rff "$PULSE_OUTPUT/jmh.json" 2>&1 | tee "$PULSE_OUTPUT/console.log"
 printf '%s\n' "$PULSE_RUN_ID" > "$PULSE_RUNTIME/last-baseline-engine-run"
 echo "Observed original engine JMH: $PULSE_OUTPUT"
