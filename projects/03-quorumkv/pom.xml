<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.cheshmakzanoon.portfolio</groupId>
    <artifactId>java-portfolio</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>quorumkv</artifactId>
  <packaging>pom</packaging>
  <modules>
    <module>raft-core</module>
    <module>raft-storage</module>
    <module>raft-transport</module>
    <module>kv-server</module>
    <module>kv-client</module>
    <module>raft-verification</module>
  </modules>
  <profiles>
    <profile>
      <id>extended</id>
      <properties>
        <quorumkv.seeds>1000</quorumkv.seeds>
      </properties>
    </profile>
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <executions>
              <execution>
                <id>default</id>
                <inherited>false</inherited>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <properties>
    <quorumkv.seeds>30</quorumkv.seeds>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <quorumkv.seeds>${quorumkv.seeds}</quorumkv.seeds>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
