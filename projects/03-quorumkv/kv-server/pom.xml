<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.cheshmakzanoon.portfolio</groupId>
    <artifactId>quorumkv</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>quorumkv-kv-server</artifactId>
  <dependencies>
    <dependency>
      <groupId>io.github.cheshmakzanoon.portfolio</groupId>
      <artifactId>quorumkv-raft-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.cheshmakzanoon.portfolio</groupId>
      <artifactId>quorumkv-raft-storage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.cheshmakzanoon.portfolio</groupId>
      <artifactId>quorumkv-raft-transport</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <configuration>
              <targetClasses>
                <param>io.github.cheshmakzanoon.portfolio.quorumkv.NodeExecutor</param>
              </targetClasses>
              <targetTests>
                <param>io.github.cheshmakzanoon.portfolio.quorumkv.NodeExecutorTest</param>
              </targetTests>
              <mutationThreshold>70</mutationThreshold>
              <threads>1</threads>
              <jvmArgs>
                <param>-Xmx512m</param>
              </jvmArgs>
              <outputFormats>
                <param>XML</param>
                <param>HTML</param>
              </outputFormats>
              <timestampedReports>false</timestampedReports>
            </configuration>
            <executions>
              <execution>
                <id>node-lifecycle-mutations</id>
                <phase>verify</phase>
                <goals>
                  <goal>mutationCoverage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
