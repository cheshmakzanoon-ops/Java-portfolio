{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LateArrival v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "eventId",
    "tenantId",
    "sensorId",
    "eventTimeEpochMillis",
    "valueMilliUnits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "$ref": "#/$defs/id"
    },
    "eventId": {
      "$ref": "#/$defs/id"
    },
    "tenantId": {
      "$ref": "#/$defs/id"
    },
    "sensorId": {
      "$ref": "#/$defs/id"
    },
    "eventTimeEpochMillis": {
      "type": "integer",
      "minimum": 0
    },
    "valueMilliUnits": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "recordType": {
      "enum": [
        "MEASUREMENT",
        "PROGRESS"
      ],
      "default": "MEASUREMENT",
      "type": "string",
      "description": "Omission defaults to MEASUREMENT; an explicitly supplied value must be a recognized string."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  }
}
