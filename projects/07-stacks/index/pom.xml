<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.cheshmakzanoon.portfolio</groupId>
    <artifactId>stacks</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>stacks-index</artifactId>
  <dependencies>
    <dependency>
      <groupId>io.github.cheshmakzanoon.portfolio</groupId>
      <artifactId>stacks-ingest</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-analysis-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>core-coverage-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.85</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <configuration>
              <targetClasses>
                <param>io.github.cheshmakzanoon.portfolio.stacks.CodeIdentifierAnalyzer*</param>
                <param>io.github.cheshmakzanoon.portfolio.stacks.SourcePreflight</param>
                <param>io.github.cheshmakzanoon.portfolio.stacks.SourceJavaParser*</param>
                <param>io.github.cheshmakzanoon.portfolio.stacks.SourceSyntax*</param>
                <param>io.github.cheshmakzanoon.portfolio.stacks.SourceCompilerBoundary*</param>
                <param>io.github.cheshmakzanoon.portfolio.stacks.SourceSymbolGraph*</param>
                <param>io.github.cheshmakzanoon.portfolio.stacks.SourceBindingResolver*</param>
                <param>io.github.cheshmakzanoon.portfolio.stacks.SourceRelations*</param>
                <param>io.github.cheshmakzanoon.portfolio.stacks.SourceWire*</param>
                <param>io.github.cheshmakzanoon.portfolio.stacks.SourceFacts*</param>
                <param>io.github.cheshmakzanoon.portfolio.stacks.SourceApiCatalog</param>
                <param>io.github.cheshmakzanoon.portfolio.stacks.DocumentMapper</param>
              </targetClasses>
              <mutationThreshold>70</mutationThreshold>
              <threads>1</threads>
              <timestampedReports>false</timestampedReports>
              <outputFormats>
                <param>XML</param>
                <param>HTML</param>
              </outputFormats>
              <failWhenNoMutations>true</failWhenNoMutations>
            </configuration>
            <executions>
              <execution>
                <id>stacks-critical</id>
                <phase>verify</phase>
                <goals>
                  <goal>mutationCoverage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
