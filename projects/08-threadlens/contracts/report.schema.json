{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/threadlens/report.schema.json",
  "title": "ThreadLens normalized profile version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordingId",
    "jdkVendor",
    "jdkVersion",
    "os",
    "architecture",
    "eventSettings",
    "startNanos",
    "endNanos",
    "sampleCount",
    "lossCounters",
    "supportedCapabilities",
    "aggregationLimits",
    "units",
    "missingEventStatus",
    "profile",
    "activeCollectionLimits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordingId": {
      "type": "string",
      "maxLength": 256
    },
    "jdkVendor": {
      "type": "string"
    },
    "jdkVersion": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "architecture": {
      "type": "string"
    },
    "eventSettings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "startNanos": {
      "type": "integer",
      "minimum": 0
    },
    "endNanos": {
      "type": "integer",
      "minimum": 0
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 0
    },
    "lossCounters": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "supportedCapabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "supported",
          "fields"
        ],
        "properties": {
          "supported": {
            "type": "boolean"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            }
          }
        }
      }
    },
    "aggregationLimits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "missingEventStatus": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "required": [
        "eventCount",
        "sampleCount",
        "startNanos",
        "endNanos",
        "flame",
        "methods",
        "windows",
        "allocations",
        "monitors",
        "parks",
        "timings",
        "counters"
      ],
      "additionalProperties": false,
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "startNanos": {
          "type": "integer",
          "minimum": 0
        },
        "endNanos": {
          "type": "integer",
          "minimum": 0
        },
        "flame": {
          "$ref": "#/$defs/flame"
        },
        "methods": {
          "type": "object",
          "maxProperties": 10000,
          "additionalProperties": {
            "$ref": "#/$defs/methodSamples"
          }
        },
        "windows": {
          "type": "object",
          "maxProperties": 900,
          "additionalProperties": {
            "$ref": "#/$defs/window"
          }
        },
        "allocations": {
          "type": "object",
          "maxProperties": 10000,
          "additionalProperties": {
            "$ref": "#/$defs/allocation"
          }
        },
        "monitors": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/timing"
          }
        },
        "parks": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/timing"
          }
        },
        "timings": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "$ref": "#/$defs/timing"
          }
        },
        "counters": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "activeCollectionLimits": {
      "type": "object",
      "description": "Actual collection limits when known; empty for offline inputs with no companion config. aggregationLimits lists absolute implementation ceilings.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "$defs": {
    "flame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "inclusive",
        "self",
        "children"
      ],
      "properties": {
        "frame": {
          "type": "string",
          "maxLength": 256
        },
        "inclusive": {
          "type": "integer",
          "minimum": 0
        },
        "self": {
          "type": "integer",
          "minimum": 0
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flame"
          }
        }
      }
    },
    "methodSamples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inclusive",
        "self"
      ],
      "properties": {
        "inclusive": {
          "type": "integer",
          "minimum": 0
        },
        "self": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "observedWeightedBytes"
      ],
      "properties": {
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "observedWeightedBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "totalNanos",
        "p50Nanos",
        "p95Nanos",
        "p99Nanos"
      ],
      "properties": {
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "totalNanos": {
          "type": "integer",
          "minimum": 0
        },
        "p50Nanos": {
          "type": "integer",
          "minimum": 0
        },
        "p95Nanos": {
          "type": "integer",
          "minimum": 0
        },
        "p99Nanos": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startNanos",
        "endNanos",
        "samples",
        "allocatedBytes",
        "gcNanos",
        "contentionNanos",
        "parkNanos",
        "incomplete"
      ],
      "properties": {
        "startNanos": {
          "type": "integer",
          "minimum": 0
        },
        "endNanos": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "allocatedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "gcNanos": {
          "type": "integer",
          "minimum": 0
        },
        "contentionNanos": {
          "type": "integer",
          "minimum": 0
        },
        "parkNanos": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "boolean"
        }
      }
    }
  }
}
